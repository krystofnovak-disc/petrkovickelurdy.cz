---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { getTrips } from '../lib/trips';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const trips = await getTrips(lang);

const categoryIcons: Record<string, string> = {
  'kultura': '🏛️', 'culture': '🏛️',
  'příroda': '🌲', 'nature': '🌲',
  'cyklo': '🚴', 'cycling': '🚴',
  'gastro': '🍷',
  'rodiny': '👨‍👩‍👧‍👦', 'families': '👨‍👩‍👧‍👦',
};
---

<section id="vylety" class="py-20 bg-bg">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">{t('trips.title')}</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {trips.map(trip => (
        <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          {trip.image ? (
            <div class="aspect-[3/2] overflow-hidden">
              <img src={trip.image} alt={trip.title} class="w-full h-full object-cover" />
            </div>
          ) : (
            <div class="aspect-[3/2] bg-gradient-to-br from-primary/10 to-secondary/10 flex items-center justify-center">
              <span class="text-4xl">{categoryIcons[trip.category] ?? '📍'}</span>
            </div>
          )}
          <div class="p-4">
            <h3 class="font-semibold mb-1">{trip.title}</h3>
            <p class="text-text-light text-sm mb-3">{trip.description}</p>
            <div class="flex items-center justify-between text-xs">
              <span class="flex flex-col gap-0.5 text-secondary">
                {trip.distanceCar && (
                  <span class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 17h.01M16 17h.01M5.2 14h13.6c.56 0 .84 0 1.054-.109a1 1 0 00.437-.437C20.4 13.24 20.4 12.96 20.4 12.4V11l-1.5-4.5c-.2-.6-.3-.9-.483-1.127a1.5 1.5 0 00-.584-.432C17.6 4.8 17.28 4.8 16.64 4.8H7.36c-.64 0-.96 0-1.193.141a1.5 1.5 0 00-.584.432C5.4 5.6 5.3 5.9 5.1 6.5L3.6 11v1.4c0 .56 0 .84.109 1.054a1 1 0 00.437.437C4.36 14 4.64 14 5.2 14z" />
                    </svg>
                    {trip.distanceCar}
                  </span>
                )}
                <span class="flex items-center gap-1 text-text-light">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {trip.distance}
                </span>
              </span>
              {trip.mapUrl && (
                <a href={trip.mapUrl} target="_blank" rel="noopener" class="text-primary hover:text-primary-dark transition-colors flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                  </svg>
                  {lang === 'cs' ? 'Navigovat' : 'Navigate'}
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
